  * - drawing_output.c
  * - drawing_text.c
  * - drawing_utils.c
  * - drawing.c
  * 
  * #### /ui/input/
  * - command.c
  * - execute_utils.c
  * - execute.c
  * - input.c
  * 
  * #### /ui/welcome/
  * - welcome_demon.c
  * - welcome_effects.c
  * - welcome_loading.c
  * - welcome_utils.c
  * - welcome.c
  */